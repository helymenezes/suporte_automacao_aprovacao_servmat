# Copie para $SERVMAT_HOST_DIR/.env e rode: chmod 600 .env
# Gere cada segredo com: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'

# Assina o cookie de sessão das pessoas (32+ caracteres).
SERVMAT_SEGREDO=

# Token do agente OpenClaw (só /api/agente/*). Vai também no cofre do OpenClaw.
SERVMAT_AGENTE_TOKEN=
# Token das agendas script (só /run/*). Vai também no cofre do OpenClaw.
SERVMAT_RUN_TOKEN=

# Onde o serviço escuta. 127.0.0.1 = só Tailscale/host; IP do docker0 = o OpenClaw também alcança.
SERVMAT_HOST=127.0.0.1
SERVMAT_PORTA=8792

# Central de leitura do Auvo (a mesma do fechamento-os). O token só lê.
SERVMAT_CENTRAL_URL=
SERVMAT_CENTRAL_TOKEN=

# Token do leitor do sistema comercial e da planilha do cliente (só /api/integracao/*). Vazio = rota desligada.
SERVMAT_INTEGRACAO_TOKEN=

# WhatsApp ao orçamentista (WAHA dedicado). Sem SERVMAT_ENVIO_REAL=1 tudo fica simulado.
SERVMAT_ENVIO_REAL=0
SERVMAT_WAHA_URL=http://127.0.0.1:3002
SERVMAT_WAHA_API_KEY=
SERVMAT_WAHA_SESSAO=default
SERVMAT_ORCAMENTISTA_WHATSAPP=
SERVMAT_ORCAMENTISTA_NOME=Orçamentista

# Transcrição do áudio (opcional): qualquer serviço compatível com POST /v1/audio/transcriptions.
# Ex.: https://api.openai.com/v1/audio/transcriptions (modelo whisper-1) ou um faster-whisper-server local.
SERVMAT_TRANSCRICAO_URL=
SERVMAT_TRANSCRICAO_CHAVE=
SERVMAT_TRANSCRICAO_MODELO=whisper-1

# 1 = cookie só por HTTPS (tailscale serve). Use 0 só em teste local por http.
SERVMAT_COOKIE_SEGURO=1
