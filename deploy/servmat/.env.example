# Copie para $SERVMAT_HOST_DIR/.env e rode: chmod 600 .env
# Gere cada segredo com: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'

# Assina o cookie de sessão das pessoas (32+ caracteres).
SERVMAT_SEGREDO=

# Token do agente OpenClaw (só /api/agente/*). Vai também no cofre do OpenClaw.
SERVMAT_AGENTE_TOKEN=
# Token das agendas script (só /run/*). Vai também no cofre do OpenClaw.
SERVMAT_RUN_TOKEN=

# Onde o serviço escuta. 127.0.0.1 = só Tailscale/host; IP do docker0 = o OpenClaw também alcança.
SERVMAT_HOST=127.0.0.1
SERVMAT_PORTA=8792

# Central de leitura do Auvo (a mesma do fechamento-os). O token só lê.
SERVMAT_CENTRAL_URL=
SERVMAT_CENTRAL_TOKEN=

# 1 = cookie só por HTTPS (tailscale serve). Use 0 só em teste local por http.
SERVMAT_COOKIE_SEGURO=1
